GEMINI_API_KEY=your_GEMINI_API_KEY_here
# Optional alias (supported): GOOGLE_API_KEY=your_GOOGLE_API_KEY_here
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional local-only fallback (requires local Ollama server)
ALLOW_OFFLINE_LLM=false

# Memory-safe defaults for small instances (e.g., Render free tier)
PRELOAD_BOT_ON_STARTUP=false
WARMUP_ON_STARTUP=false
AUTO_INDEX_DOCUMENTS=false
LOW_MEMORY_MODE=true
ENABLE_RAG=false
RAG_WORKERS=1
DEBUG_TOKEN_LOG=false
